# 将本文件复制为云服务器上的 .env.cloud，并按实际情况修改。
# 不要提交 .env.cloud，其中会包含生产密钥。

# ---------------------------------------------------------------------------
# 公网部署必填。缺一项都会导致后台裸奔。
# ---------------------------------------------------------------------------

# 必填。可用以下命令生成： openssl rand -base64 32
# 同时也是 Provider API Key 落库加密的派生源，换掉会导致已存的 Key 解不开。
SL_SECRET_KEY=replace-with-a-long-random-secret

# 必填。默认值是 false —— 不设这一项，AuthMiddleware 会放行所有请求，
# 任何人都能读写你的题库/笔记/待办/Wiki，并调用你的 LLM 端点烧你的额度。
SL_AUTH_ENABLED=true

# 必填。默认口令 changeme123 写在仓库里，等同于无密码；
# 开了 SL_AUTH_ENABLED 后仍用默认口令的话，服务会拒绝启动。
SL_AUTH_BOOTSTRAP_ADMIN_EMAIL=you@example.com
SL_AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# 关闭注册（默认就是 false，公网务必保持关闭）。
SL_AUTH_ALLOW_REGISTER=false

# 你的公网访问源，用于 CORS。同域 Nginx 部署时填你的域名。
SL_CORS_ORIGINS=https://your-domain.example

# 反向代理在前面时必须开，否则限流会把所有人算成同一个 IP（共用一个桶）。
# 反过来，后端如果直接暴露、前面没有可信代理，务必保持 false —— 否则
# 客户端可以伪造 X-Forwarded-For 绕过限流。
SL_TRUST_PROXY_HEADERS=true

# ---------------------------------------------------------------------------
# 保持默认即可（列在这里是为了让你知道它们存在）
# ---------------------------------------------------------------------------

# 交互式 API 文档。默认 false。公网上开启等于公开整张 API 地图，别开。
# SL_API_DOCS_ENABLED=false

# 限流（每客户端 IP）。默认：登录 15 分钟 10 次，写操作 5 分钟 120 次。
# SL_RATE_LIMIT_ENABLED=true
# SL_RATE_LIMIT_AUTH_PER_WINDOW=10
# SL_RATE_LIMIT_AUTH_WINDOW_SECONDS=900
# SL_RATE_LIMIT_WRITE_PER_WINDOW=120
# SL_RATE_LIMIT_WRITE_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# 危险项：公网部署下不要设置
# ---------------------------------------------------------------------------

# SL_BOT_API_TOKEN 是一个直接映射到 tenant 1 的服务令牌（等同管理员，
# 见 core/auth_middleware.py）。前端要用它，就必须通过 VITE_SL_BOT_TOKEN
# 打进 JS bundle —— 而 bundle 是明文公开的，等于把管理员凭证发给每个访客。
# 公网部署请留空，用正常的用户名密码登录。
# 它只适用于本机开发（vite dev proxy 在 Node 侧注入，不进浏览器）。
# SL_BOT_API_TOKEN=

# ---------------------------------------------------------------------------
# 可选：飞书机器人集成
# ---------------------------------------------------------------------------

# 注意：webhook 端点是公开的（不走 JWT）。若不配 VERIFICATION_TOKEN，
# verify_event_token 会直接放行（fail-open），任何人都能伪造事件驱动机器人
# 并消耗你的 LLM 额度。启用机器人时这两项务必填。
SL_FEISHU_BOT_ENABLED=false
SL_FEISHU_APP_ID=
SL_FEISHU_APP_SECRET=
SL_FEISHU_VERIFICATION_TOKEN=
SL_FEISHU_ENCRYPT_KEY=
# 留空即拒绝所有人（fail-closed）。填你自己的 open_id。
SL_FEISHU_ALLOWED_OPEN_IDS=

# ---------------------------------------------------------------------------
# 可选：Obsidian 同步
# ---------------------------------------------------------------------------

# 云端部署时，需要先把 vault 挂载进后端容器，然后把这里设置为容器内路径。
SL_OBSIDIAN_SYNC_ENABLED=false
SL_OBSIDIAN_VAULT_PATH=
SL_OBSIDIAN_SYNC_IGNORE_DIRS=
