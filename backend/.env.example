# SmartLearning 后端环境变量示例
# 用法：复制本文件为同目录下的 .env，再按注释填写真实值
#   copy .env.example .env   (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)
# 注意：.env 含密钥，切勿提交到 Git

# ---------------------------------------------------------------------------
# 基础（一般不用改）
# ---------------------------------------------------------------------------
# SL_HOST=127.0.0.1
# SL_PORT=8000
# SL_DATA_DIR=./data

# 生产或穿透公网时建议固定，否则重启后加密的 Provider API Key 可能无法解密
# SL_SECRET_KEY=请换成一长串随机字符串

# ---------------------------------------------------------------------------
# 多租户登录鉴权（默认开启）
# ---------------------------------------------------------------------------
# SL_AUTH_ENABLED=true
# SL_AUTH_TOKEN_EXPIRE_HOURS=168
# SL_AUTH_ALLOW_REGISTER=false
# 首次启动自动创建默认租户管理员（仅当 users 表为空时）
# SL_AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@local
# SL_AUTH_BOOTSTRAP_ADMIN_PASSWORD=changeme123

# ---------------------------------------------------------------------------
# 穿透公网时强烈建议（保护除飞书 Webhook 外的 /api/*）
# ---------------------------------------------------------------------------
# 自行生成：PowerShell 可用 [guid]::NewGuid().ToString("N") + 随机字符
# SL_BOT_API_TOKEN=

# ---------------------------------------------------------------------------
# 飞书 Bot（不用飞书可整段保持注释或 feishu_bot_enabled=false）
# ---------------------------------------------------------------------------

# 必须为 true 才处理飞书事件（注意小写 true，不要加引号）
SL_FEISHU_BOT_ENABLED=false

# 飞书开放平台 → 你的应用 → 凭证与基础信息
SL_FEISHU_APP_ID=
SL_FEISHU_APP_SECRET=

# 飞书开放平台 → 事件订阅 → Verification Token（与后台显示完全一致）
SL_FEISHU_VERIFICATION_TOKEN=

# 仅当事件订阅里开启了「加密」时才填 Encrypt Key；未开启则留空
SL_FEISHU_ENCRYPT_KEY=

# 允许使用机器人的飞书用户 open_id，多个用英文逗号分隔，无空格
# 获取方式见 README「飞书 Bot」小节
SL_FEISHU_ALLOWED_OPEN_IDS=

# ---------------------------------------------------------------------------
# Obsidian vault 同步（可选）
# ---------------------------------------------------------------------------
# SL_OBSIDIAN_SYNC_ENABLED=false
# SL_OBSIDIAN_VAULT_PATH=D:/Obsidian/MyVault
# SL_OBSIDIAN_SYNC_DEBOUNCE_SECONDS=5
# SL_OBSIDIAN_SYNC_ON_START=true
# SL_OBSIDIAN_SYNC_DEDUPE_AFTER=false
# SL_OBSIDIAN_SYNC_IGNORE_DIRS=Archive,Templates

# ---------------------------------------------------------------------------
# Wiki RAG（bge-small-zh，需 pip install -e ".[rag]"）
# ---------------------------------------------------------------------------
# SL_RAG_ENABLED=true
# SL_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# SL_RAG_TOP_K=5
# SL_RAG_MIN_SCORE=0.35
# SL_RAG_DEFAULT_IN_CHAT=true
# SL_RAG_AUTO_INDEX=true

# ---------------------------------------------------------------------------
# 题库语义去重（DashScope / OpenAI 兼容 Embedding）
# ---------------------------------------------------------------------------
# SL_DEDUPE_USE_EMBEDDING=true
# SL_DEDUPE_EMBEDDING_THRESHOLD=0.92
# SL_EMBEDDING_PROVIDER=openai_compatible
# SL_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# SL_EMBEDDING_API_KEY=your-dashscope-api-key
# SL_EMBEDDING_MODEL=text-embedding-v4
# SL_EMBEDDING_DIMENSIONS=1024
# SL_EMBEDDING_ENCODING_FORMAT=float

# 可选 Milvus 向量检索（需 pip install -e ".[milvus]"）
# SL_MILVUS_ENABLED=true
# SL_MILVUS_HOST=localhost
# SL_MILVUS_PORT=19530
# SL_MILVUS_COLLECTION=sl_questions
# SL_MILVUS_METRIC=L2
# SL_MILVUS_INDEX=IVF_FLAT
# SL_MILVUS_INDEX_NLIST=128
# SL_MILVUS_SEARCH_NPROBE=10
